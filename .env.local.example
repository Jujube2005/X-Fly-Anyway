# ─── Supabase ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# Your Supabase project URL (found in: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Your Supabase publishable (anon) key (found in: Project Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# ─── App ───────────────────────────────────────────────────────────────
# Base URL for generating absolute links (used in metadata and OG tags)
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Registered Company Test Device Identity
COMPANY_DEVICE_IDENTITY_EMAIL=mind0m0i0n0d@gmail.com
